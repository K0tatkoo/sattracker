<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- DayNight, so the app follows the phone's dark/light setting like the
         other n3d apps. It also decides what the WebView reports as
         prefers-color-scheme on Android 13+, though the page does not rely on
         that: MainActivity tells it outright (Android.theme / onTheme), and
         sets the bar icons in code as well, because they have to change live. -->
    <style name="Base.Theme.SatelliteTracker" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="colorPrimary">@color/accent</item>
    </style>

    <style name="Theme.SatelliteTracker" parent="Base.Theme.SatelliteTracker" />
</resources>
